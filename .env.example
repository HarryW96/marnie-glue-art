# ── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Cloudinary ───────────────────────────────
# Get these from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Auth ────────────────────────────────────
# Change this to a strong random string before deploying
ADMIN_PASSWORD=changeme123
JWT_SECRET=replace_with_a_long_random_secret_string

# ── Database ─────────────────────────────────
# Path to SQLite file (relative to project root)
DB_PATH=./studio.db

# ── Email notifications (Resend) ─────────────
# Sign up at https://resend.com and get your API key from the dashboard.
# Leave blank to disable email notifications.
RESEND_API_KEY=re_your_api_key
# The email address that receives new enquiry notifications
NOTIFICATION_EMAIL=artist@example.com
# The "from" address — must be a verified sender in your Resend account.
# For testing only (sends to your own verified email): onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@yourdomain.com
